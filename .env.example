SUPABASE_URL=https://fbxrcnxgslihxzoxlwtg.supabase.co
SUPABASE_ANON_KEY=
AIRSUP_DB_TOKEN=

# Optional fallbacks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WEBSITE_DOMAIN=
# Optional IANA override (e.g. Europe/Berlin). Otherwise inferred from the website
# (country TLD, DNS nameservers, site language/content, then hosting GeoIP).
OWNER_TIMEZONE=
WEBSITE_TIMEZONE=
AGENT_WEBHOOK_URL=
AGENT_SECRET=
# Any provider key works in onboarding (OpenAI, Anthropic, Google, Groq, OpenRouter, xAI, …).
# Defaults always use each provider's newest best-understanding model
# (gpt-5.6, claude-fable-5, gemini-3.1-pro-preview, grok-4.5, …).
# Optional: force an OpenAI-compatible base URL/model for DeepSeek, Together, Fireworks, etc.
# Site knowledge: Supi crawls every page under the connected domain and refreshes often.
# Optional overrides: SITE_KNOWLEDGE_MAX_PAGES, SITE_KNOWLEDGE_STALE_MS, CRON_SECRET
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
# Website-owner Google Calendar / Gmail OAuth (Airsup company agent tools)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {requestOrigin}/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CRON_SECRET=
SITE_KNOWLEDGE_MAX_PAGES=120
SITE_KNOWLEDGE_STALE_MS=120000
SETUP_PASSWORD=
ADMIN_PASSWORD=
