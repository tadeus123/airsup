SUPABASE_URL=https://fbxrcnxgslihxzoxlwtg.supabase.co
SUPABASE_ANON_KEY=
AIRSUP_DB_TOKEN=

# Optional fallbacks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WEBSITE_DOMAIN=
# Optional IANA override (e.g. Europe/Berlin). Otherwise inferred from the website
# (country TLD, DNS nameservers, site language/content, then hosting GeoIP).
OWNER_TIMEZONE=
WEBSITE_TIMEZONE=
AGENT_WEBHOOK_URL=
AGENT_SECRET=
# Any provider key works in onboarding (OpenAI, Anthropic, Google, Groq, OpenRouter, xAI, …).
# Defaults prefer fast chat models that finish inside browser/ChatGPT budgets (~15s).
# Optional: force an OpenAI-compatible base URL/model for DeepSeek, Together, Fireworks, etc.
# Site knowledge: crawled by cron / background refresh — /agent/chat never sync-crawls.
# Optional overrides: SITE_KNOWLEDGE_MAX_PAGES, SITE_KNOWLEDGE_STALE_MS, SITE_KNOWLEDGE_MAX_PROMPT_CHARS,
# LLM_TIMEOUT_MS, LLM_MAX_ATTEMPTS, LLM_MAX_OUTPUT_TOKENS, CRON_SECRET
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=14000
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=1536
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
# Website-owner Google Calendar / Gmail OAuth (Airsup company agent tools)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {requestOrigin}/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CRON_SECRET=
SITE_KNOWLEDGE_MAX_PAGES=120
SITE_KNOWLEDGE_STALE_MS=1800000
SITE_KNOWLEDGE_MAX_PROMPT_CHARS=24000
SETUP_PASSWORD=
ADMIN_PASSWORD=
# Optional shared secret for the live long-poll watch endpoints
# (/agent/watch and /agent/watch/push). When set, both require a matching
# token (query token=... or header x-watch-token). Leave blank to keep open.
WATCH_SECRET=
